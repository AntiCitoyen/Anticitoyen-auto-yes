#!/usr/bin/expect -f
# auto-yes : lance une commande et répond automatiquement "1" (Oui) à chaque
# menu de confirmation qui correspond à un motif de /etc/auto-yes/patterns.conf.
# Terminal pleinement interactif (Ctrl-C, taille de fenêtre, ce que vous tapez :
# tout est transmis, seul le motif déclenche un envoi).
#
#   auto-yes <commande> [arguments...]    exemple : auto-yes apt install paquet
#   auto-yes --pause | --reprise          suspend / reprend les réponses dans tous les terminaux
#   auto-yes --etat | --journal [N]       état, N dernières lignes du journal

source [file join [file dirname [file dirname [file normalize [info script]]]] share auto-yes commun.tcl]

if {$argc < 1 || [lindex $argv 0] in {-h --help --aide}} {
    send_user "usage : auto-yes <commande> \[arguments...\]\n"
    send_user "        auto-yes --pause | --reprise | --etat | --journal \[N\]\n"
    send_user "répond automatiquement \"1\" (Oui) quand un motif de /etc/auto-yes/patterns.conf apparaît\n"
    exit [expr {$argc < 1}]
}
if {[auto_yes::gerer $argv]} { exit 0 }

set actions [auto_yes::actions]
log_user 1
set timeout -1
spawn -noecho {*}$argv
auto_yes::apres_spawn
interact {*}$actions
catch wait
