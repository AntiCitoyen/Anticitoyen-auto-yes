#!/usr/bin/expect -f
# auto-yes-shell : lance le shell de connexion de l'utilisateur, pleinement
# interactif, et répond automatiquement "1" (Oui) chaque fois qu'un motif de
# /etc/auto-yes/patterns.conf apparaît dans N'IMPORTE QUELLE commande tapée
# dans ce terminal — pas besoin de préfixer par "auto-yes".
#
# AUTO_YES_ACTIVE évite un ré-emballage récursif si ce terminal relance
# lui-même un terminal ou un sous-shell.

if {[info exists ::env(AUTO_YES_ACTIVE)]} {
    catch {exec -- $::env(SHELL) -l <@stdin >@stdout 2>@stderr}
    exit
}
set ::env(AUTO_YES_ACTIVE) 1

source [file join [file dirname [file dirname [file normalize [info script]]]] share auto-yes commun.tcl]

set shell "/bin/bash"
if {[info exists ::env(SHELL)] && $::env(SHELL) ne ""} { set shell $::env(SHELL) }

set actions [auto_yes::actions]
log_user 1
set timeout -1
spawn -noecho $shell -l
auto_yes::apres_spawn
interact {*}$actions
catch wait
